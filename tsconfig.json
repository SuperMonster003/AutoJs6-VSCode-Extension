{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "outDir": "out",
        "rootDir": "src",
        "lib": [ "es2020" ],
        "types": [ "node" ],
        "sourceMap": true,
        "resolveJsonModule": true,
        "noImplicitThis": true,
        "strictBindCallApply": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true
    },
    "include": [ "src/**/*.ts" ],
    "exclude": [ "node_modules", "out", ".vscode-test", "assets" ]
}
