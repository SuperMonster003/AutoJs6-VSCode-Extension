{
    "name": "autojs6-vscode-ext",
    "displayName": "AutoJs6 VSCode Extension",
    "description": "%extension.description%",
    "version": "1.1.0",
    "requiredClientVersionName": "6.7.0",
    "requiredClientVersionCode": "3591",
    "publisher": "003",
    "icon": "assets/images/autojs6_material.png",
    "repository": {
        "type": "github",
        "url": "http://vscext-project.autojs6.com"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onFileSystem:autojs6fs"
    ],
    "main": "./dist/extension.js",
    "l10n": "./l10n",
    "contributes": {
        "breakpoints": [
            {
                "language": "javascript"
            }
        ],
        "commands": [
            {
                "command": "extension.viewDocument",
                "title": "%command.extension.viewDocument.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.connect",
                "title": "%command.extension.connect.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/link.svg",
                    "dark": "assets/icons-night/link.svg"
                }
            },
            {
                "command": "extension.showQrCode",
                "title": "%command.extension.showQrCode.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.disconnectAll",
                "title": "%command.extension.disconnectAll.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.disconnectDevice",
                "title": "%command.extension.disconnectDevice.title%",
                "category": "AutoJs6",
                "icon": "$(debug-disconnect)"
            },
            {
                "command": "extension.selectDevice",
                "title": "%command.extension.selectDevice.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.reconnect",
                "title": "%command.extension.reconnect.title%",
                "category": "AutoJs6",
                "icon": "$(refresh)"
            },
            {
                "command": "extension.cancelReconnect",
                "title": "%command.extension.cancelReconnect.title%",
                "category": "AutoJs6",
                "icon": "$(close)"
            },
            {
                "command": "extension.manageTrustedDevices",
                "title": "%command.extension.manageTrustedDevices.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.run",
                "title": "%command.extension.run.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/play-circle.svg",
                    "dark": "assets/icons-night/play-circle.svg"
                }
            },
            {
                "command": "extension.runWithoutArguments",
                "title": "%command.extension.runWithoutArguments.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/play-circle.svg",
                    "dark": "assets/icons-night/play-circle.svg"
                }
            },
            {
                "command": "extension.runOnDevice",
                "title": "%command.extension.runOnDevice.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.stop",
                "title": "%command.extension.stop.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/error.svg",
                    "dark": "assets/icons-night/error.svg"
                }
            },
            {
                "command": "extension.stopAll",
                "title": "%command.extension.stopAll.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/close-all.svg",
                    "dark": "assets/icons-night/close-all.svg"
                }
            },
            {
                "command": "extension.rerun",
                "title": "%command.extension.rerun.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.save",
                "title": "%command.extension.save.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/save.svg",
                    "dark": "assets/icons-night/save.svg"
                }
            },
            {
                "command": "extension.saveToDevice",
                "title": "%command.extension.saveToDevice.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.newUntitledFile",
                "title": "%command.extension.newUntitledFile.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.newProject",
                "title": "%command.extension.newProject.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/diff-added.svg",
                    "dark": "assets/icons-night/diff-added.svg"
                }
            },
            {
                "command": "extension.saveProject",
                "title": "%command.extension.saveProject.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/save-all.svg",
                    "dark": "assets/icons-night/save-all.svg"
                }
            },
            {
                "command": "extension.saveProjectWithoutArguments",
                "title": "%command.extension.saveProjectWithoutArguments.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/save-all.svg",
                    "dark": "assets/icons-night/save-all.svg"
                }
            },
            {
                "command": "extension.resyncProject",
                "title": "%command.extension.resyncProject.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.pullProject",
                "title": "%command.extension.pullProject.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.runProject",
                "title": "%command.extension.runProject.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/run-all.svg",
                    "dark": "assets/icons-night/run-all.svg"
                }
            },
            {
                "command": "extension.runProjectWithoutArguments",
                "title": "%command.extension.runProjectWithoutArguments.title%",
                "category": "AutoJs6",
                "icon": {
                    "light": "assets/icons/run-all.svg",
                    "dark": "assets/icons-night/run-all.svg"
                }
            },
            {
                "command": "extension.remoteFiles.browse",
                "title": "%command.extension.remoteFiles.browse.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.remoteFiles.refresh",
                "title": "%command.extension.remoteFiles.refresh.title%",
                "category": "AutoJs6",
                "icon": "$(refresh)"
            },
            {
                "command": "extension.remoteFiles.open",
                "title": "%command.extension.remoteFiles.open.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.remoteFiles.run",
                "title": "%command.extension.remoteFiles.run.title%",
                "category": "AutoJs6",
                "icon": "$(play)"
            },
            {
                "command": "extension.remoteFiles.delete",
                "title": "%command.extension.remoteFiles.delete.title%",
                "category": "AutoJs6",
                "icon": "$(trash)"
            },
            {
                "command": "extension.remoteFiles.rename",
                "title": "%command.extension.remoteFiles.rename.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.remoteFiles.newFolder",
                "title": "%command.extension.remoteFiles.newFolder.title%",
                "category": "AutoJs6",
                "icon": "$(new-folder)"
            },
            {
                "command": "extension.remoteFiles.newFile",
                "title": "%command.extension.remoteFiles.newFile.title%",
                "category": "AutoJs6",
                "icon": "$(new-file)"
            },
            {
                "command": "extension.remoteFiles.uploadCurrentFile",
                "title": "%command.extension.remoteFiles.uploadCurrentFile.title%",
                "category": "AutoJs6",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "extension.remoteFiles.uploadFiles",
                "title": "%command.extension.remoteFiles.uploadFiles.title%",
                "category": "AutoJs6"
            },
            {
                "command": "extension.remoteFiles.download",
                "title": "%command.extension.remoteFiles.download.title%",
                "category": "AutoJs6",
                "icon": "$(cloud-download)"
            },
            {
                "command": "extension.remoteFiles.copyPath",
                "title": "%command.extension.remoteFiles.copyPath.title%",
                "category": "AutoJs6"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "extension.connect",
                    "group": "navigation@60"
                },
                {
                    "command": "extension.runWithoutArguments",
                    "group": "navigation@63",
                    "when": "resourceLangId == javascript || resourceLangId == typescript"
                },
                {
                    "command": "extension.stop",
                    "group": "navigation@66",
                    "when": "resourceLangId == javascript || resourceLangId == typescript"
                },
                {
                    "command": "extension.stopAll",
                    "group": "navigation@69"
                },
                {
                    "command": "extension.save",
                    "group": "navigation@72"
                },
                {
                    "command": "extension.runProjectWithoutArguments",
                    "group": "navigation@75"
                },
                {
                    "command": "extension.saveProjectWithoutArguments",
                    "group": "navigation@78"
                },
                {
                    "command": "extension.newProject",
                    "group": "navigation@81"
                }
            ],
            "explorer/context": [
                {
                    "command": "extension.run",
                    "group": "navigation@60",
                    "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(js|mjs|cjs|ts|auto)$/"
                },
                {
                    "command": "extension.runOnDevice",
                    "group": "navigation@63",
                    "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(js|mjs|cjs|ts|auto)$/"
                },
                {
                    "command": "extension.stop",
                    "group": "navigation@69",
                    "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(js|mjs|cjs|ts|auto)$/"
                },
                {
                    "command": "extension.stopAll",
                    "group": "navigation@72",
                    "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(js|mjs|cjs|ts|auto)$/"
                },
                {
                    "command": "extension.rerun",
                    "group": "navigation@75",
                    "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(js|mjs|cjs|ts|auto)$/"
                },
                {
                    "command": "extension.saveToDevice",
                    "group": "navigation@78",
                    "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(js|mjs|cjs|ts|auto)$/"
                },
                {
                    "command": "extension.save",
                    "group": "navigation@81",
                    "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(js|mjs|cjs|ts|auto)$/"
                },
                {
                    "command": "extension.runProject",
                    "group": "navigation@84",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "command": "extension.saveProject",
                    "group": "navigation@87",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "command": "extension.resyncProject",
                    "group": "navigation@88",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "command": "extension.pullProject",
                    "group": "navigation@89",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "command": "extension.newProject",
                    "group": "navigation@90",
                    "when": "explorerResourceIsFolder"
                }
            ],
            "commandPalette": [
                {
                    "command": "extension.runWithoutArguments",
                    "when": "false"
                },
                {
                    "command": "extension.runProjectWithoutArguments",
                    "when": "false"
                },
                {
                    "command": "extension.saveProjectWithoutArguments",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.refresh",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.open",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.run",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.delete",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.rename",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.newFolder",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.newFile",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.uploadCurrentFile",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.uploadFiles",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.download",
                    "when": "false"
                },
                {
                    "command": "extension.remoteFiles.copyPath",
                    "when": "false"
                },
                {
                    "command": "extension.disconnectDevice",
                    "when": "autojs6.connected"
                },
                {
                    "command": "extension.cancelReconnect",
                    "when": "autojs6.reconnecting"
                }
            ],
            "view/title": [
                {
                    "command": "extension.connect",
                    "when": "view == autojs6.devices",
                    "group": "navigation@1"
                },
                {
                    "command": "extension.remoteFiles.refresh",
                    "when": "view == autojs6.deviceFiles",
                    "group": "navigation@1"
                },
                {
                    "command": "extension.remoteFiles.browse",
                    "when": "view == autojs6.deviceFiles",
                    "group": "1_actions@1"
                },
                {
                    "command": "extension.disconnectAll",
                    "when": "view == autojs6.devices",
                    "group": "1_actions@1"
                },
                {
                    "command": "extension.reconnect",
                    "when": "view == autojs6.devices",
                    "group": "1_actions@2"
                },
                {
                    "command": "extension.cancelReconnect",
                    "when": "view == autojs6.devices && autojs6.reconnecting",
                    "group": "1_actions@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "extension.disconnectDevice",
                    "when": "view == autojs6.devices && viewItem =~ /^device/",
                    "group": "inline"
                },
                {
                    "command": "extension.remoteFiles.refresh",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(device|root|directory)$/",
                    "group": "inline@9"
                },
                {
                    "command": "extension.remoteFiles.newFolder",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(root|directory)$/",
                    "group": "inline@1"
                },
                {
                    "command": "extension.remoteFiles.newFile",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(root|directory)$/",
                    "group": "inline@2"
                },
                {
                    "command": "extension.remoteFiles.uploadCurrentFile",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(root|directory)$/",
                    "group": "inline@3"
                },
                {
                    "command": "extension.remoteFiles.run",
                    "when": "view == autojs6.deviceFiles && viewItem == fs.script",
                    "group": "inline@1"
                },
                {
                    "command": "extension.remoteFiles.download",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(file|script)$/",
                    "group": "inline@2"
                },
                {
                    "command": "extension.remoteFiles.delete",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(file|script|directory)$/",
                    "group": "inline@8"
                },
                {
                    "command": "extension.remoteFiles.run",
                    "when": "view == autojs6.deviceFiles && viewItem == fs.script",
                    "group": "1_run@1"
                },
                {
                    "command": "extension.remoteFiles.open",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(file|script)$/",
                    "group": "1_run@2"
                },
                {
                    "command": "extension.remoteFiles.newFolder",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(root|directory)$/",
                    "group": "2_new@1"
                },
                {
                    "command": "extension.remoteFiles.newFile",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(root|directory)$/",
                    "group": "2_new@2"
                },
                {
                    "command": "extension.remoteFiles.uploadCurrentFile",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(root|directory)$/",
                    "group": "3_transfer@1"
                },
                {
                    "command": "extension.remoteFiles.uploadFiles",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(root|directory)$/",
                    "group": "3_transfer@2"
                },
                {
                    "command": "extension.remoteFiles.download",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(file|script)$/",
                    "group": "3_transfer@3"
                },
                {
                    "command": "extension.remoteFiles.rename",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(file|script|directory)$/",
                    "group": "4_modify@1"
                },
                {
                    "command": "extension.remoteFiles.delete",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\.(file|script|directory)$/",
                    "group": "4_modify@2"
                },
                {
                    "command": "extension.remoteFiles.copyPath",
                    "when": "view == autojs6.deviceFiles && viewItem =~ /^fs\\./",
                    "group": "5_misc@1"
                }
            ]
        },
        "keybindings": [
            {
                "command": "extension.viewDocument",
                "key": "alt+shift+f6",
                "mac": "cmd+shift+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.run",
                "key": "f6",
                "mac": "f6",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.stopAll",
                "key": "ctrl+shift+f6",
                "mac": "ctrl+shift+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.connect",
                "key": "ctrl+alt+f6",
                "mac": "ctrl+cmd+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.disconnectAll",
                "key": "ctrl+alt+shift+f6",
                "mac": "ctrl+cmd+shift+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.stop",
                "key": "ctrl+f6",
                "mac": "ctrl+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.runProject",
                "key": "alt+f6",
                "mac": "cmd+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.runProject",
                "key": "ctrl+alt+6 r",
                "mac": "ctrl+cmd+6 r",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.newProject",
                "key": "ctrl+alt+6 n",
                "mac": "ctrl+cmd+6 n",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.saveProject",
                "key": "ctrl+alt+6 s",
                "mac": "ctrl+cmd+6 s",
                "when": "editorTextFocus"
            },
            {
                "command": "extension.showQrCode",
                "key": "ctrl+alt+6 q",
                "mac": "ctrl+cmd+6 q",
                "when": "editorTextFocus"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "autojs6",
                    "title": "AutoJs6",
                    "icon": "assets/icons/autojs6.svg"
                }
            ]
        },
        "views": {
            "autojs6": [
                {
                    "id": "autojs6.devices",
                    "name": "%view.autojs6.devices.name%",
                    "contextualTitle": "%view.autojs6.devices.contextualTitle%"
                },
                {
                    "id": "autojs6.deviceFiles",
                    "name": "%view.autojs6.deviceFiles.name%",
                    "contextualTitle": "%view.autojs6.deviceFiles.contextualTitle%"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "autojs6.devices",
                "contents": "%viewsWelcome.autojs6.devices.contents%"
            },
            {
                "view": "autojs6.deviceFiles",
                "contents": "%viewsWelcome.autojs6.deviceFiles.contents%",
                "when": "!autojs6.connected"
            }
        ],
        "configuration": {
            "title": "AutoJs6",
            "properties": {
                "autojs6.server.port": {
                    "type": "number",
                    "default": 6347,
                    "description": "%config.autojs6.server.port.description%",
                    "minimum": 1,
                    "maximum": 65535
                },
                "autojs6.server.confirmUnknownDevices": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.autojs6.server.confirmUnknownDevices.description%"
                },
                "autojs6.client.port": {
                    "type": "number",
                    "default": 7347,
                    "description": "%config.autojs6.client.port.description%",
                    "minimum": 1,
                    "maximum": 65535
                },
                "autojs6.http.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.autojs6.http.enabled.description%"
                },
                "autojs6.http.host": {
                    "type": "string",
                    "default": "127.0.0.1",
                    "description": "%config.autojs6.http.host.description%"
                },
                "autojs6.http.port": {
                    "type": "number",
                    "default": 10347,
                    "description": "%config.autojs6.http.port.description%",
                    "minimum": 1,
                    "maximum": 65535
                },
                "autojs6.adb.path": {
                    "type": "string",
                    "default": "",
                    "description": "%config.autojs6.adb.path.description%"
                },
                "autojs6.discovery.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.autojs6.discovery.enabled.description%"
                },
                "autojs6.connection.connectTimeout": {
                    "type": "number",
                    "default": 8000,
                    "description": "%config.autojs6.connection.connectTimeout.description%",
                    "minimum": 1000
                },
                "autojs6.connection.handshakeTimeout": {
                    "type": "number",
                    "default": 6000,
                    "description": "%config.autojs6.connection.handshakeTimeout.description%",
                    "minimum": 1000
                },
                "autojs6.connection.heartbeatInterval": {
                    "type": "number",
                    "default": 15000,
                    "description": "%config.autojs6.connection.heartbeatInterval.description%",
                    "minimum": 0
                },
                "autojs6.connection.heartbeatTimeout": {
                    "type": "number",
                    "default": 10000,
                    "description": "%config.autojs6.connection.heartbeatTimeout.description%",
                    "minimum": 1000
                },
                "autojs6.connection.autoReconnect": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.autojs6.connection.autoReconnect.description%"
                },
                "autojs6.connection.maxReconnectAttempts": {
                    "type": "number",
                    "default": 0,
                    "description": "%config.autojs6.connection.maxReconnectAttempts.description%",
                    "minimum": 0
                },
                "autojs6.connection.reconnectTimeout": {
                    "type": "number",
                    "default": 300,
                    "description": "%config.autojs6.connection.reconnectTimeout.description%",
                    "minimum": 0
                },
                "autojs6.connection.reconnectMaxDelay": {
                    "type": "number",
                    "default": 10000,
                    "description": "%config.autojs6.connection.reconnectMaxDelay.description%",
                    "minimum": 1000
                },
                "autojs6.connection.restoreOnStartup": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.autojs6.connection.restoreOnStartup.description%"
                },
                "autojs6.log.showChannelOnConnect": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.autojs6.log.showChannelOnConnect.description%"
                },
                "autojs6.log.disposeChannelOnDisconnect": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.autojs6.log.disposeChannelOnDisconnect.description%"
                },
                "autojs6.log.debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.autojs6.log.debug.description%"
                },
                "autojs6.save.keepRelativePath": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.autojs6.save.keepRelativePath.description%"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run bundle",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "bundle": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify --legal-comments=none",
        "bundle-dev": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap",
        "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
        "package": "vsce package",
        "publish": "vsce publish"
    },
